# Mesmo espaçamento para todo mundo, em qualquer editor.
# VS Code e PyCharm leem este arquivo sozinhos; nada para configurar à mão.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# Em Markdown, dois espaços no fim da linha são quebra de linha proposital.
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.sql]
indent_size = 2

[Makefile]
indent_style = tab
