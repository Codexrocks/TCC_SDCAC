  "info": {
    "description": "Leitura dos resultados do **Sistema de Avaliação Multidimensional de Risco\nComportamental**.\n\nToda nota vem **decomposta nas cinco parcelas** — `c0`, `d1`, `d2`,\n`d3_conduct`, `d3_posture`. Parcela nula significa *dimensão não avaliada nesta\nconfiguração*, e é diferente de zero, que significa *avaliada e sem risco*.\n\nEsta API **não calcula**: faixa, parcela e motivo vêm do motor; métrica vem do\navaliador. Nenhuma rota escreve, e nenhuma lê o gabarito.",
    "title": "SDCAC — API de leitura",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/configurations": {
      "get": {
        "description": "As configuracoes com parametro, com o hash de cada uma.\n\nSai dos presets versionados, e nao do banco: e o painel sabendo o que cada\nexecucao ligou sem precisar deduzir do nome.",
        "operationId": "configuracoes_api_v1_configurations_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Configuracao"
                  },
                  "title": "Response Configuracoes Api V1 Configurations Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Os presets canonicos da ablacao"
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Diz se vale tentar, e quantas execucoes existem para consultar.",
        "operationId": "saude_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saude"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "A API esta de pe?"
      }
    },
    "/api/v1/runs": {
      "get": {
        "description": "Da mais recente para a mais antiga, com semente, commit e hash.",
        "operationId": "execucoes_api_v1_runs_get",
        "parameters": [
          {
            "description": "Itens por pagina, no maximo 200",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "Itens por pagina, no maximo 200",
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Quantos itens pular",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Quantos itens pular",
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pagina_Execucao_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Execucoes de pontuacao"
      }
    },
    "/api/v1/runs/{scoring_run_id}": {
      "get": {
        "operationId": "execucao_api_v1_runs__scoring_run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "scoring_run_id",
            "required": true,
            "schema": {
